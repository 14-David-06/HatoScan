{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewResult",
  "description": "Detecciones confirmadas por un revisor humano. Es el dato oficial y la fuente del dataset de entrenamiento.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "conteo_id",
    "reviewer_id",
    "reviewed_at",
    "source_detector_version",
    "image",
    "detections",
    "total"
  ],
  "properties": {
    "conteo_id": { "type": "string", "pattern": "^SIRIUS-CONTEO-[0-9]{4,}$" },
    "reviewer_id": { "type": "string", "pattern": "^SIRIUS-PER-[0-9]{4,}$" },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "source_detector_version": { "type": "string" },
    "image": { "$ref": "image-info.schema.json" },
    "detections": {
      "type": "array",
      "description": "Incluye las descartadas (negativos para entrenamiento).",
      "items": { "$ref": "detection.schema.json" }
    },
    "total": { "type": "integer", "minimum": 0, "description": "Número de detecciones activas." }
  }
}
