{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Detection",
  "description": "Un animal detectado o marcado. Coordenadas en píxeles de la imagen original, origen arriba-izquierda. Para tipo 'caja', (x, y) es la esquina superior izquierda.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "x", "y", "tipo", "origen", "estado"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "x": { "type": "number", "minimum": 0 },
    "y": { "type": "number", "minimum": 0 },
    "tipo": { "type": "string", "enum": ["punto", "caja"] },
    "w": { "type": "number", "exclusiveMinimum": 0 },
    "h": { "type": "number", "exclusiveMinimum": 0 },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "origen": { "type": "string", "enum": ["modelo", "humano"] },
    "estado": { "type": "string", "enum": ["activa", "descartada"] }
  }
}
