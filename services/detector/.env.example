# Token compartido con la web (misma cadena que DETECTOR_API_TOKEN en apps/web/.env.local).
# Obligatorio: sin él, /v1/* responde 503. Genera uno con:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
DETECTOR_API_TOKEN=
# Hosts de los que se aceptan URLs de imagen (JSON). Solo el host de APP_BASE_URL de la web; el
# detector nunca descarga de otras direcciones. En producción: ["hatoscan.vercel.app"].
DETECTOR_ALLOWED_IMAGE_HOSTS=["localhost"]
# Tamaño máximo de imagen aceptado, en bytes (80 MB).
DETECTOR_MAX_IMAGE_BYTES=83886080
# Tiempo máximo para descargar la imagen desde la URL firmada, en segundos.
DETECTOR_IMAGE_DOWNLOAD_TIMEOUT_S=60
# Detector usado cuando la petición no indica uno.
DETECTOR_DEFAULT_DETECTOR=classic-cv
