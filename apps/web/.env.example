# Detección con IA (ADR 0007): corre dentro de esta app y llama a los modelos por API. Sin la llave
# de un proveedor, sus métodos aparecen como «no disponibles». Solo en el servidor: nunca NEXT_PUBLIC_.
# Llave de Claude (métodos claude-vision y claude-vision-sonnet): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Llave de OpenAI (métodos openai-vision y openai-vision-sol).
OPENAI_API_KEY=
# Método usado cuando la persona no elige uno. Debe estar entre los habilitados.
DETECTOR_DEFAULT_METHOD=claude-vision
# Métodos que se ofrecen, separados por comas. Vacío = todos.
DETECTOR_ENABLED_METHODS=claude-vision,claude-vision-sonnet,openai-vision,openai-vision-sol
# Tiempo máximo de una detección, en milisegundos (máx. 790000). Por debajo del maxDuration (800 s)
# de la ruta de procesamiento, para dejar el conteo en `error` antes de que Vercel corte la función.
DETECTOR_TIMEOUT_MS=780000

# URL pública de esta app. Con STORAGE_DRIVER=local, las URLs firmadas de imágenes apuntan aquí.
APP_BASE_URL=http://localhost:3000
# Vigencia de las URLs de lectura de imágenes, en segundos.
IMAGE_URL_TTL_SECONDS=900
# Vigencia de las URLs de subida directa de la foto original, en segundos.
UPLOAD_URL_TTL_SECONDS=900

# Almacenamiento de imágenes y JSON (D1, ADR 0006): `local` (disco, desarrollo) o `s3` (producción).
STORAGE_DRIVER=local

# STORAGE_DRIVER=local (ver docs/adr/0004).
LOCAL_DATA_DIR=.data
# Mínimo 32 caracteres. Genera uno con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
LOCAL_STORAGE_SIGNING_SECRET=

# STORAGE_DRIVER=s3: bucket privado y llaves del usuario IAM `hatoscan-web` (ver docs/despliegue.md).
# No se usan los nombres AWS_*: Vercel los reserva.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Airtable (D2: base propia de HatoScan). Con STORAGE_DRIVER=s3 la tabla Conteos es obligatoria.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_CONTEOS_TABLE_ID=
# Tabla Usuarios (login). Las cuentas se administran en Airtable.
AIRTABLE_USUARIOS_TABLE_ID=

# Secreto HMAC de la cookie de sesión. Mínimo 32 caracteres; genera uno igual que el de arriba.
AUTH_SESSION_SECRET=
