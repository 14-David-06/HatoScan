# URL base del servicio de detección (Cloud Run). Sin barra final.
DETECTOR_BASE_URL=http://localhost:8000
# Tiempo máximo de espera de una detección, en milisegundos.
DETECTOR_TIMEOUT_MS=120000
# Token compartido con el detector (misma cadena que DETECTOR_API_TOKEN en services/detector/.env).
DETECTOR_API_TOKEN=

# URL pública de esta app. Las URLs firmadas de imágenes apuntan aquí: el detector debe poder
# alcanzarla (en local, el detector corre en la misma máquina).
APP_BASE_URL=http://localhost:3000
# Vigencia de las URLs de lectura de imágenes, en segundos.
IMAGE_URL_TTL_SECONDS=900

# Adaptadores locales de desarrollo (ver docs/adr/0004). Se reemplazan al cerrar D1 y D2.
LOCAL_DATA_DIR=.data
# Mínimo 32 caracteres. Genera uno con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
LOCAL_STORAGE_SIGNING_SECRET=

# Airtable — pendiente de D2 (qué base). No se usan todavía.
AIRTABLE_API_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_CONTEOS_TABLE_ID=

# Almacenamiento de objetos — pendiente de D1 (Pinata privado vs. GCS). No se usa todavía.
